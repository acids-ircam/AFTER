from __gin__ import dynamic_registration
include 'midi.gin'
from after import diffusion

# Export-only fixtures: random tiny weights, no training or external models.
IN_SIZE = 8
N_SIGNAL = 8
ZS_CHANNELS = 4
ZT_CHANNELS = 2

encoder/diffusion.networks.ecapa_encoder.ECAPATDNN:
    channels = [8, 8, 8, 16]
    attention_channels = 4
    se_channels = 4

encoder_time/diffusion.networks.Encoder1D:
    channels = [8, 8, %ZS_CHANNELS]
    ratios = [2, 2]

diffusion.networks.transformerv2.DenoiserV2:
    embed_dim = 128
    noise_embed_dims = 16
    n_layers = 1
    mlp_multiplier = 2
    dropout = 0.0
